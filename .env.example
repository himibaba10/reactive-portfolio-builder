MONGODB_URI=mongodb://127.0.0.1:27017/reactive-portfolio-builder
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (required for auth — email/password + Google)
# Dev keys are written to .env.local by `pnpm dlx clerk@latest init`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Rate limiting (optional locally — without this, in-memory limits are used)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary (required for section image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional — Clerk sends auth mail; Resend only if you add other app emails)
RESEND_API_KEY=
EMAIL_FROM=Reactive <noreply@reactiveferdous.com>
