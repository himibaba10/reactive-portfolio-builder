<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title><%= subject %></title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #060708;
      color: #f4f5f0;
      font-family:
        'Segoe UI',
        Helvetica,
        Arial,
        sans-serif;
      -webkit-font-smoothing: antialiased;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color: #060708; padding: 32px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width: 560px;
              background-color: #12141a;
              border: 1px solid rgba(244, 245, 240, 0.12);
              border-radius: 24px;
              overflow: hidden;
            "
          >
            <tr>
              <td
                style="
                  padding: 28px 28px 8px;
                  border-bottom: 1px solid rgba(244, 245, 240, 0.08);
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td>
                      <% if (logoUrl) { %>
                      <img
                        src="<%= logoUrl %>"
                        alt="Reactive"
                        width="140"
                        style="display: block; height: auto; max-width: 140px"
                      />
                      <% } else { %>
                      <span
                        style="
                          font-size: 18px;
                          font-weight: 700;
                          letter-spacing: -0.03em;
                          color: #f4f5f0;
                        "
                        >Reactive</span
                      >
                      <% } %>
                    </td>
                    <td align="right">
                      <span
                        style="
                          font-size: 11px;
                          letter-spacing: 0.18em;
                          text-transform: uppercase;
                          color: #d6ff3f;
                        "
                        ><%= eyebrow %></span
                      >
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding: 32px 28px 8px">
                <h1
                  style="
                    margin: 0 0 12px;
                    font-size: 28px;
                    line-height: 1.15;
                    letter-spacing: -0.04em;
                    font-weight: 700;
                    color: #f4f5f0;
                  "
                >
                  <%= heading %>
                </h1>
                <p
                  style="
                    margin: 0 0 24px;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #8b909a;
                  "
                >
                  <%= body %>
                </p>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td
                      align="center"
                      bgcolor="#d6ff3f"
                      style="border-radius: 999px"
                    >
                      <a
                        href="<%= actionUrl %>"
                        style="
                          display: inline-block;
                          padding: 14px 22px;
                          font-size: 14px;
                          font-weight: 700;
                          color: #0a0b0d;
                          text-decoration: none;
                          border-radius: 999px;
                        "
                        ><%= actionLabel %></a
                      >
                    </td>
                  </tr>
                </table>
                <p
                  style="
                    margin: 28px 0 0;
                    font-size: 12px;
                    line-height: 1.55;
                    color: #6b7280;
                    word-break: break-all;
                  "
                >
                  Or open this link:<br />
                  <a
                    href="<%= actionUrl %>"
                    style="color: #5b8cff; text-decoration: none"
                    ><%= actionUrl %></a
                  >
                </p>
                <% if (footnote) { %>
                <p
                  style="
                    margin: 20px 0 0;
                    font-size: 12px;
                    line-height: 1.5;
                    color: #6b7280;
                  "
                >
                  <%= footnote %>
                </p>
                <% } %>
              </td>
            </tr>
            <tr>
              <td style="padding: 24px 28px 28px">
                <div
                  style="
                    height: 1px;
                    background: rgba(244, 245, 240, 0.08);
                    margin-bottom: 18px;
                  "
                ></div>
                <p
                  style="
                    margin: 0;
                    font-size: 11px;
                    letter-spacing: 0.14em;
                    text-transform: uppercase;
                    color: #6b7280;
                  "
                >
                  One page. Your slug. Strictly beautiful.
                </p>
                <p style="margin: 8px 0 0; font-size: 12px; color: #6b7280">
                  <a
                    href="<%= appUrl %>"
                    style="color: #8b909a; text-decoration: none"
                    >reactive portfolio builder</a
                  >
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
